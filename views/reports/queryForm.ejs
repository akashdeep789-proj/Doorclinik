<% layout('layouts/boilerplate') %>

<div class="container mt-5">
  <h3 class="mb-4">Ask Questions About Your Report</h3>

  <form action="/ai-report/query/<%= report._id %>" method="POST" class="mb-4">
    <div class="input-group">
      <input type="text" name="question" class="form-control" placeholder="Ask a question" value="<%= question || '' %>">
      <button type="submit" class="btn btn-primary">Ask</button>
    </div>
  </form>

  <% if (answer) { %>
    <div class="card mb-4">
      <div class="card-header bg-success text-white">Answer:</div>
      <div class="card-body">
        <p><%= answer %></p>
      </div>
    </div>

    <div class="card">
      <div class="card-header bg-info text-white">Relevant Chunks Used:</div>
      <div class="card-body">
        <% topChunks.forEach((c, i) => { %>
          <div class="border p-2 mb-2 rounded">
            <strong>Chunk <%= i + 1 %> (score: <%= c.score.toFixed(3) %>)</strong>
            <p><%= c.chunk %></p>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>
</div>
