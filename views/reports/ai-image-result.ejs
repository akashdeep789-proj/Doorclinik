<% layout('layouts/boilerplate') %>

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card shadow-sm">
        <div class="card-body">
          <h3 class="card-title text-center mb-4" style="color:#fe424d;">
            AI Generated Image
          </h3>

          <% if (prompt && imageData) { %>
            <p class="text-center text-muted">Prompt: "<%= prompt %>"</p>

            <div class="text-center my-4">
              <img src="<%= imageData %>" class="img-fluid rounded shadow" alt="AI Generated Image" />
            </div>

            <div class="d-flex justify-content-center gap-2 flex-wrap">
              <a href="<%= imageData %>" class="btn btn-success" download="AI_Image.jpg">Download Image</a>
              <a href="/ai-report/image/<%= report._id %>" class="btn btn-outline-danger">Generate Another Image</a>
              <a href="/ai-report/text-result/<%= report._id %>" class="btn btn-warning">Back to Report Summary</a>
            </div>
          <% } else { %>
            <p class="text-center text-danger">No image generated. Please try again.</p>
            <div class="text-center mt-3">
              <a href="/ai-report/image/<%= report._id %>" class="btn btn-outline-danger">Try Again</a>
              <a href="/ai-report/text-result/<%= report._id %>" class="btn btn-warning">Back to Report Summary</a>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
