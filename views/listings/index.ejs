<% layout("/layouts/boilerplate") %>

<div class="clinic-filters">
  <a href="/listings/specialization/General Physician" class="clinic-filter-pill">
    <i class="fa-solid fa-user-doctor"></i> General Physicians
  </a>
  <a href="/listings/specialization/Cardiologist" class="clinic-filter-pill">
    <i class="fa-solid fa-heart-pulse"></i> Cardiologists
  </a>
  <a href="/listings/specialization/Neurologist" class="clinic-filter-pill">
    <i class="fa-solid fa-brain"></i> Neurologists
  </a>
  <a href="/listings/specialization/Dentist" class="clinic-filter-pill">
    <i class="fa-solid fa-tooth"></i> Dentists
  </a>
  <a href="/listings/specialization/Eye Specialist" class="clinic-filter-pill">
    <i class="fa-solid fa-eye"></i> Eye Specialists
  </a>
  <a href="/listings/specialization/Pediatrician" class="clinic-filter-pill">
    <i class="fa-solid fa-baby"></i> Pediatricians
  </a>
  <a href="/listings/specialization/Vaccination" class="clinic-filter-pill">
    <i class="fa-solid fa-syringe"></i> Vaccinations
  </a>
  <a href="/listings/specialization/Diagnostics" class="clinic-filter-pill">
    <i class="fa-solid fa-x-ray"></i> Diagnostics
  </a>

  <div class="clinic-tax-toggle">
    <div class="form-check-reverse form-switch mb-0">
      <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
      <label class="form-check-label" for="switchCheckDefault">Show fee with GST</label>
    </div>
  </div>
</div>

<% if (allListings.length === 0) { %>
  <div class="text-center mt-4">
    <% if (query) { %>
      <h4>No doctors found for "<%= query %>"</h4>
    <% } else { %>
      <h4>No doctors found in this specialization</h4>
    <% } %>
  </div>
<% } %>

<% if (allListings.length > 0) { %>
  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-3 mt-1 mb-4">
    <% for (let listing of allListings) { %>
      <div class="col">
        <a href="/listings/<%= listing._id %>" class="doctor-card">
          <img src="<%= listing.image.url %>" class="doctor-card-img" alt="doctor_image" />
          <div class="doctor-card-body">
            <div class="doctor-card-name">Dr. <%= listing.title %></div>
            <div class="doctor-card-spec"><%= listing.specialization %></div>
            <div class="doctor-card-fee">
              &#8377;<%= listing.price.toLocaleString("en-IN") %> consultation
              <span class="tax-info"> &nbsp;+18% GST</span>
            </div>
          </div>
        </a>
      </div>
    <% } %>
  </div>
<% } %>

<script>
  let taxSwitch = document.getElementById("switchCheckDefault");
  taxSwitch.addEventListener("click", () => {
    let taxInfo = document.getElementsByClassName("tax-info");
    for (let info of taxInfo) {
      if (info.style.display !== "inline") {
        info.style.display = "inline";
      } else {
        info.style.display = "none";
      }
    }
  });
</script>