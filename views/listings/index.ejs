<% layout("/layouts/boilerplate") %>    

<style>
  #filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  .filter {
    text-align: center;
    margin-right: 2rem;
    margin-top: 2rem;
    opacity: 0.7;
    text-decoration: none;
    color: inherit;
  }

  .filter:hover {
    opacity: 1;
    cursor: pointer;
  }

  .filter p {
    font-size: 0.8rem;
    margin-bottom: 0;
  }

  .tax-info {
    display: none;
  }

  .filter i {
    color: darkgreen;
    font-size: 2rem;
  }

  .tax-toggle {
    border: 1px solid black;
    border-radius: 1rem;
    height: 3.2rem;
    padding: 1rem;
    margin-left: 2rem;
    margin-top: 2rem;
    display: flex;
    align-items: center;
  }

  .listing-link {
    text-decoration: none;
    color: inherit;
  }

  .listing-card img {
    object-fit: cover;
    object-position: top;
  }
</style>    

<div id="filters">
  <a href="/listings/specialization/General Physician" class="filter">
    <div><i class="fa-solid fa-user-doctor"></i></div>
    <p>General Physicians</p>
  </a>
  <a href="/listings/specialization/Cardiologist" class="filter">
    <div><i class="fa-solid fa-heart-pulse"></i></div>
    <p>Cardiologists</p>
  </a>
  <a href="/listings/specialization/Neurologist" class="filter">
    <div><i class="fa-solid fa-brain"></i></div>
    <p>Neurologists</p>
  </a>
  <a href="/listings/specialization/Dentist" class="filter">
    <div><i class="fa-solid fa-tooth"></i></div>
    <p>Dentists</p>
  </a>
  <a href="/listings/specialization/Eye Specialist" class="filter">
    <div><i class="fa-solid fa-eye"></i></div>
    <p>Eye Specialists</p>
  </a>
  <a href="/listings/specialization/Pediatrician" class="filter">
    <div><i class="fa-solid fa-baby"></i></div>
    <p>Pediatricians</p>
  </a>
  <a href="/listings/specialization/Vaccination" class="filter">
    <div><i class="fa-solid fa-syringe"></i></div>
    <p>Vaccinations</p>
  </a>
  <a href="/listings/specialization/Diagnostics" class="filter">
    <div><i class="fa-solid fa-x-ray"></i></div>
    <p>Diagnostics</p>
  </a>

  <div class="tax-toggle">
    <div class="form-check-reverse form-switch">
      <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
      <label class="form-check-label" for="switchCheckDefault">Show Consultation Fee with GST</label>
    </div>
  </div>
</div>    

<% if (allListings.length === 0) { %>
  <div class="text-center mt-4">
    <% if (typeof query !== "undefined" && query) { %>
      <h4>No doctors found for "<%= query %>"</h4>
    <% } else { %>
      <h4>No doctors found in this specialization</h4>
    <% } %>
  </div>
<% } %>

<% if (allListings.length > 0) { %>
  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
    <% for (let listing of allListings) { %>  
      <a href="/listings/<%= listing._id %>" class="listing-link">
        <div class="card col listing-card mb-4">
          <img 
            src="<%= listing.image && listing.image.url ? listing.image.url : 'https://via.placeholder.com/300x300?text=Doctor+Image' %>" 
            class="card-img-top" 
            alt="doctor_image" 
            style="height: 20rem;"
            referrerpolicy="no-referrer"
            onerror="this.onerror=null; this.src='https://via.placeholder.com/300x300?text=Doctor+Image';"
          />
          <div class="card-img-overlay"></div>
          <div class="card-body">
            <p class="card-text">
              <b><%= listing.title %></b><br>
              <small><i><%= listing.specialization %></i></small><br>
              Consultation Fee: ₹<%= listing.price ? listing.price.toLocaleString("en-IN") : '0' %>
              <i class="tax-info"> &nbsp; &nbsp;+18% GST</i>
            </p>          
          </div>
        </div>
      </a>
    <% } %>
  </div>
<% } %>

<script>
  let taxSwitch = document.getElementById("switchCheckDefault"); 
  if (taxSwitch) {
    taxSwitch.addEventListener("click", () => {
      let taxInfo = document.getElementsByClassName("tax-info"); 
      for (let info of taxInfo) {                                
        if (info.style.display !== "inline") {
          info.style.display = "inline";
        } else {
          info.style.display = "none";
        }
      }
    });
  }
</script>