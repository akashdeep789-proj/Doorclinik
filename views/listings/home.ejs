<% layout("/layouts/boilerplate") %>

<style>
  /* =========================
     DOORCLINIK ABOUT PAGE
     ========================= */

  .about-page {
    background: #f8fafc;
    color: #172033;
  }

  /* HERO */
  .about-hero {
    min-height: 560px;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 85% 20%, rgba(254, 66, 77, 0.12), transparent 30%),
      radial-gradient(circle at 10% 80%, rgba(37, 99, 235, 0.10), transparent 30%),
      linear-gradient(135deg, #ffffff 0%, #f3f7ff 100%);
  }

  .about-hero-container {
    max-width: 1200px;
    width: 100%;
    margin: auto;
    padding: 80px 25px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 60px;
    align-items: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 30px;
    background: #fff;
    border: 1px solid #e5e7eb;
    color: #fe424d;
    font-weight: 600;
    font-size: 14px;
    margin-bottom: 20px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
  }

  .about-hero h1 {
    font-size: clamp(42px, 6vw, 68px);
    line-height: 1.05;
    font-weight: 800;
    margin-bottom: 22px;
    letter-spacing: -2px;
  }

  .about-hero h1 span {
    color: #fe424d;
  }

  .about-hero-description {
    font-size: 18px;
    line-height: 1.8;
    color: #64748b;
    max-width: 650px;
    margin-bottom: 32px;
  }

  .hero-buttons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
  }

  .hero-primary-btn,
  .hero-secondary-btn {
    text-decoration: none;
    padding: 13px 25px;
    border-radius: 30px;
    font-weight: 700;
    transition: 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .hero-primary-btn {
    background: #fe424d;
    color: white;
    box-shadow: 0 10px 25px rgba(254, 66, 77, 0.25);
  }

  .hero-primary-btn:hover {
    color: white;
    transform: translateY(-3px);
    background: #e83440;
  }

  .hero-secondary-btn {
    background: white;
    color: #172033;
    border: 1px solid #dbe1ea;
  }

  .hero-secondary-btn:hover {
    color: #fe424d;
    border-color: #fe424d;
    transform: translateY(-3px);
  }

  /* HERO VISUAL */
  .hero-visual {
    position: relative;
    min-height: 390px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .medical-card {
    width: 330px;
    background: white;
    border-radius: 25px;
    padding: 25px;
    box-shadow: 0 25px 70px rgba(15, 23, 42, 0.13);
    position: relative;
    z-index: 2;
  }

  .medical-card-header {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 25px;
  }

  .medical-icon {
    width: 60px;
    height: 60px;
    border-radius: 18px;
    background: #fff0f1;
    color: #fe424d;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
  }

  .medical-card-header h5 {
    margin: 0;
    font-weight: 700;
  }

  .medical-card-header p {
    margin: 4px 0 0;
    color: #64748b;
    font-size: 13px;
  }

  .appointment-mini {
    padding: 15px;
    border-radius: 15px;
    background: #f8fafc;
    margin-bottom: 12px;
  }

  .appointment-mini strong {
    display: block;
    margin-bottom: 5px;
  }

  .appointment-mini span {
    color: #64748b;
    font-size: 13px;
  }

  .appointment-status {
    color: #16a34a;
    font-weight: 700;
    font-size: 13px;
  }

  .floating-card {
    position: absolute;
    background: white;
    border-radius: 15px;
    padding: 14px 18px;
    box-shadow: 0 15px 40px rgba(15, 23, 42, 0.12);
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 600;
  }

  .floating-card i {
    color: #fe424d;
  }

  .floating-one {
    top: 35px;
    right: 0;
  }

  .floating-two {
    bottom: 40px;
    left: 0;
  }

  /* COMMON SECTION */
  .about-section {
    max-width: 1200px;
    margin: auto;
    padding: 90px 25px;
  }

  .section-heading {
    text-align: center;
    margin-bottom: 50px;
  }

  .section-label {
    color: #fe424d;
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 10px;
  }

  .section-heading h2 {
    font-size: 38px;
    font-weight: 800;
    margin-bottom: 15px;
  }

  .section-heading p {
    max-width: 720px;
    margin: auto;
    color: #64748b;
    line-height: 1.7;
  }

  /* PROJECT OVERVIEW */
  .overview-section {
    background: white;
  }

  .overview-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 35px;
    align-items: stretch;
  }

  .overview-content {
    padding: 35px;
    border-radius: 25px;
    background: #f8fafc;
    border: 1px solid #e8edf3;
  }

  .overview-content h3 {
    font-weight: 800;
    margin-bottom: 15px;
  }

  .overview-content p {
    color: #64748b;
    line-height: 1.8;
  }

  .problem-list {
    margin-top: 25px;
    padding: 0;
    list-style: none;
  }

  .problem-list li {
    margin-bottom: 14px;
    display: flex;
    gap: 12px;
    color: #475569;
  }

  .problem-list i {
    color: #fe424d;
    margin-top: 4px;
  }

  .overview-highlight {
    border-radius: 25px;
    padding: 35px;
    background: linear-gradient(135deg, #fe424d, #fc5c7d);
    color: white;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .overview-highlight h3 {
    font-size: 28px;
    font-weight: 800;
    margin-bottom: 15px;
  }

  .overview-highlight p {
    line-height: 1.8;
    opacity: 0.92;
  }

  /* APPLICATIONS */
  .applications-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .application-card {
    background: white;
    padding: 30px;
    border-radius: 22px;
    border: 1px solid #e7ebf0;
    transition: 0.3s ease;
  }

  .application-card:hover {
    transform: translateY(-7px);
    box-shadow: 0 18px 40px rgba(15, 23, 42, 0.09);
  }

  .application-icon {
    width: 58px;
    height: 58px;
    border-radius: 17px;
    background: #fff1f2;
    color: #fe424d;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    margin-bottom: 20px;
  }

  .application-card h4 {
    font-weight: 750;
    margin-bottom: 12px;
  }

  .application-card p {
    color: #64748b;
    line-height: 1.7;
    margin: 0;
  }

  /* ROLE SECTION */
  .role-section {
    background: #f1f5f9;
  }

  .role-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
  }

  .role-card {
    background: white;
    border-radius: 25px;
    padding: 35px;
    border-top: 4px solid #fe424d;
  }

  .role-card.doctor {
    border-top-color: #2563eb;
  }

  .role-card.admin {
    border-top-color: #7c3aed;
  }

  .role-icon {
    font-size: 34px;
    margin-bottom: 18px;
  }

  .role-card h3 {
    font-weight: 800;
    margin-bottom: 20px;
  }

  .role-card ul {
    padding: 0;
    list-style: none;
    margin: 0;
  }

  .role-card li {
    padding: 9px 0;
    color: #64748b;
    border-bottom: 1px solid #f1f5f9;
  }

  .role-card li i {
    margin-right: 8px;
    color: #16a34a;
  }

  /* AI SECTION */
  .ai-section {
    background: white;
  }

  .ai-container {
    background: linear-gradient(135deg, #111827, #1e293b);
    color: white;
    border-radius: 30px;
    padding: 55px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 45px;
    align-items: center;
  }

  .ai-container h2 {
    font-size: 38px;
    font-weight: 800;
    margin-bottom: 18px;
  }

  .ai-container > div > p {
    color: #cbd5e1;
    line-height: 1.8;
  }

  .ai-features {
    display: grid;
    gap: 15px;
  }

  .ai-feature {
    padding: 20px;
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 16px;
    display: flex;
    gap: 15px;
    align-items: flex-start;
  }

  .ai-feature i {
    color: #fb7185;
    font-size: 21px;
    margin-top: 3px;
  }

  .ai-feature h5 {
    margin: 0 0 5px;
    font-weight: 700;
  }

  .ai-feature p {
    margin: 0;
    color: #94a3b8;
    font-size: 14px;
    line-height: 1.6;
  }

  /* WORKFLOW */
  .workflow-section {
    background: #f8fafc;
  }

  .workflow {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    position: relative;
  }

  .workflow-step {
    text-align: center;
    position: relative;
  }

  .step-number {
    width: 58px;
    height: 58px;
    margin: 0 auto 18px;
    border-radius: 50%;
    background: #fe424d;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 18px;
  }

  .workflow-step h5 {
    font-weight: 750;
  }

  .workflow-step p {
    color: #64748b;
    font-size: 14px;
    line-height: 1.6;
  }

  /* TECH STACK */
  .tech-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .tech-badge {
    padding: 12px 20px;
    border-radius: 30px;
    background: white;
    border: 1px solid #dfe5ec;
    font-weight: 650;
    color: #334155;
    transition: 0.25s ease;
  }

  .tech-badge:hover {
    border-color: #fe424d;
    color: #fe424d;
    transform: translateY(-3px);
  }

  /* SECURITY */
  .security-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .security-card {
    background: white;
    padding: 25px;
    border-radius: 20px;
    border: 1px solid #e5e7eb;
    text-align: center;
  }

  .security-card i {
    font-size: 28px;
    color: #fe424d;
    margin-bottom: 15px;
  }

  .security-card h5 {
    font-weight: 750;
  }

  .security-card p {
    color: #64748b;
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
  }

  /* CTA */
  .final-cta {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px 25px 90px;
  }

  .cta-box {
    border-radius: 30px;
    padding: 70px 30px;
    text-align: center;
    background: linear-gradient(135deg, #fe424d, #fc5c7d);
    color: white;
    box-shadow: 0 20px 50px rgba(254, 66, 77, 0.2);
  }

  .cta-box h2 {
    font-size: 42px;
    font-weight: 800;
    margin-bottom: 15px;
  }

  .cta-box p {
    max-width: 650px;
    margin: 0 auto 30px;
    line-height: 1.7;
    opacity: 0.92;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    background: white;
    color: #fe424d;
    padding: 14px 28px;
    border-radius: 30px;
    font-weight: 800;
    transition: 0.3s ease;
  }

  .cta-btn:hover {
    color: #fe424d;
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.15);
  }

  /* RESPONSIVE */
  @media (max-width: 992px) {
    .about-hero-container {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .about-hero-description {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-buttons {
      justify-content: center;
    }

    .hero-visual {
      max-width: 500px;
      margin: auto;
      width: 100%;
    }

    .applications-grid,
    .role-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .security-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-container {
      grid-template-columns: 1fr;
    }

    .workflow {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .about-hero {
      min-height: auto;
    }

    .about-hero-container {
      padding: 60px 20px;
    }

    .about-section {
      padding: 65px 20px;
    }

    .overview-grid,
    .applications-grid,
    .role-grid,
    .security-grid,
    .workflow {
      grid-template-columns: 1fr;
    }

    .section-heading h2,
    .ai-container h2,
    .cta-box h2 {
      font-size: 30px;
    }

    .medical-card {
      width: 290px;
    }

    .floating-one {
      right: -5px;
    }

    .floating-two {
      left: -5px;
    }

    .ai-container {
      padding: 35px 25px;
    }
  }

  @media (max-width: 480px) {
    .hero-visual {
      min-height: 330px;
    }

    .medical-card {
      width: 250px;
      padding: 18px;
    }

    .floating-card {
      font-size: 11px;
      padding: 10px 12px;
    }

    .about-hero h1 {
      font-size: 40px;
    }
  }
</style>


<div class="about-page">

  <!-- =========================
       HERO
       ========================= -->
  <section class="about-hero">

    <div class="about-hero-container">

      <div>

        <div class="hero-badge">
          <i class="fa-solid fa-stethoscope"></i>
          Smart Healthcare Platform
        </div>

        <h1>
          Healthcare made
          <span>simple.</span>
        </h1>

        <p class="about-hero-description">
          Doorclinik is a smart healthcare platform that connects
          patients with doctors, simplifies appointment booking,
          provides AI-powered assistance, and supports emergency
          ambulance services — all in one place.
        </p>

        <div class="hero-buttons">

          <a href="/listings" class="hero-primary-btn">
            <i class="fa-solid fa-user-doctor"></i>
            Explore Clinics
          </a>

          <a href="#applications" class="hero-secondary-btn">
            <i class="fa-solid fa-circle-info"></i>
            Explore Features
          </a>

        </div>

      </div>


      <!-- HERO VISUAL -->

      <div class="hero-visual">

        <div class="medical-card">

          <div class="medical-card-header">

            <div class="medical-icon">
              <i class="fa-solid fa-user-doctor"></i>
            </div>

            <div>
              <h5>Doctor Appointment</h5>
              <p>Doorclinik Healthcare</p>
            </div>

          </div>

          <div class="appointment-mini">
            <strong>Find a Specialist</strong>
            <span>Choose from multiple medical specialties</span>
          </div>

          <div class="appointment-mini">
            <strong>Book Appointment</strong>
            <span>Select a convenient date and time</span>
          </div>

          <div class="appointment-mini">
            <strong>Appointment Status</strong>
            <span class="appointment-status">
              <i class="fa-solid fa-circle-check"></i>
              Securely Booked
            </span>
          </div>

        </div>

        <div class="floating-card floating-one">
          <i class="fa-solid fa-robot"></i>
          AI Assistance
        </div>

        <div class="floating-card floating-two">
          <i class="fa-solid fa-truck-medical"></i>
          Emergency Support
        </div>

      </div>

    </div>

  </section>


  <!-- =========================
       PROJECT OVERVIEW
       ========================= -->

  <section class="overview-section">

    <div class="about-section">

      <div class="section-heading">

        <div class="section-label">
          About The Project
        </div>

        <h2>
          What is Doorclinik?
        </h2>

        <p>
          Doorclinik is a full-stack healthcare appointment platform
          designed to make doctor discovery and healthcare management
          easier for patients, doctors, and administrators.
        </p>

      </div>


      <div class="overview-grid">

        <div class="overview-content">

          <h3>
            The Problem
          </h3>

          <p>
            Finding the right doctor, checking availability, booking
            appointments, and managing healthcare services can be
            difficult when everything is handled through separate
            systems.
          </p>

          <ul class="problem-list">

            <li>
              <i class="fa-solid fa-check"></i>
              Difficult doctor discovery
            </li>

            <li>
              <i class="fa-solid fa-check"></i>
              Manual appointment management
            </li>

            <li>
              <i class="fa-solid fa-check"></i>
              Limited healthcare assistance
            </li>

            <li>
              <i class="fa-solid fa-check"></i>
              Lack of integrated emergency support
            </li>

          </ul>

        </div>


        <div class="overview-highlight">

          <h3>
            Our Solution
          </h3>

          <p>
            Doorclinik brings doctor discovery, appointment booking,
            patient reviews, AI assistance, report summarization,
            administration, and ambulance services together into
            a single healthcare ecosystem.
          </p>

          <p>
            The platform is designed around three major users:
            <strong>Patients, Doctors, and Administrators.</strong>
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- =========================
       APPLICATIONS
       ========================= -->

  <section id="applications">

    <div class="about-section">

      <div class="section-heading">

        <div class="section-label">
          Applications
        </div>

        <h2>
          Everything in one healthcare platform
        </h2>

        <p>
          Doorclinik provides multiple integrated services to
          simplify healthcare discovery and management.
        </p>

      </div>


      <div class="applications-grid">

        <div class="application-card">

          <div class="application-icon">
            <i class="fa-solid fa-user-doctor"></i>
          </div>

          <h4>Doctor Discovery</h4>

          <p>
            Patients can browse doctors by name, specialization,
            and available healthcare services.
          </p>

        </div>


        <div class="application-card">

          <div class="application-icon">
            <i class="fa-solid fa-calendar-check"></i>
          </div>

          <h4>Appointment Booking</h4>

          <p>
            Patients can select doctors, choose available slots,
            and book appointments securely.
          </p>

        </div>


        <div class="application-card">

          <div class="application-icon">
            <i class="fa-solid fa-star"></i>
          </div>

          <h4>Patient Reviews</h4>

          <p>
            Patients can provide ratings and reviews based on
            their healthcare experience.
          </p>

        </div>


        <div class="application-card">

          <div class="application-icon">
            <i class="fa-solid fa-robot"></i>
          </div>

          <h4>AI Assistant</h4>

          <p>
            An AI-powered assistant helps users understand their
            healthcare needs and navigate the platform.
          </p>

        </div>


        <div class="application-card">

          <div class="application-icon">
            <i class="fa-solid fa-file-medical"></i>
          </div>

          <h4>AI Report Summarization</h4>

          <p>
            Medical reports can be summarized with AI to make
            complex information easier to understand.
          </p>

        </div>


        <div class="application-card">

          <div class="application-icon">
            <i class="fa-solid fa-truck-medical"></i>
          </div>

          <h4>Ambulance Services</h4>

          <p>
            Users can request emergency ambulance services while
            drivers can register and manage their access.
          </p>

        </div>


        <div class="application-card">

          <div class="application-icon">
            <i class="fa-solid fa-hospital"></i>
          </div>

          <h4>Clinic Management</h4>

          <p>
            Doctors and clinic owners can add and manage their
            healthcare listings on the platform.
          </p>

        </div>


        <div class="application-card">

          <div class="application-icon">
            <i class="fa-solid fa-chart-column"></i>
          </div>

          <h4>Analytics Dashboard</h4>

          <p>
            Administrators can monitor platform activity and
            analyze healthcare application data.
          </p>

        </div>


        <div class="application-card">

          <div class="application-icon">
            <i class="fa-solid fa-shield-halved"></i>
          </div>

          <h4>Secure Authentication</h4>

          <p>
            Role-based authentication separates patient, doctor,
            and administrator functionality.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- =========================
       USER ROLES
       ========================= -->

  <section class="role-section">

    <div class="about-section">

      <div class="section-heading">

        <div class="section-label">
          User Roles
        </div>

        <h2>
          Built for every healthcare participant
        </h2>

        <p>
          Each user type gets a dedicated experience according
          to their responsibilities.
        </p>

      </div>


      <div class="role-grid">

        <!-- PATIENT -->

        <div class="role-card">

          <div class="role-icon">
            👤
          </div>

          <h3>Patient</h3>

          <ul>

            <li>
              <i class="fa-solid fa-check"></i>
              Search for doctors
            </li>

            <li>
              <i class="fa-solid fa-check"></i>
              Browse specializations
            </li>

            <li>
              <i class="fa-solid fa-check"></i>
              View doctor profiles
            </li>

            <li>
              <i class="fa-solid fa-check"></i>
              Book appointments
            </li>

            <li>
              <i class="fa-solid fa-check"></i>
              Manage appointments
            </li>

            <li>
              <i class="fa-solid fa-check"></i>
              Submit reviews
            </li>

            <li>
              <i class="fa-solid fa-check"></i>
              Use AI assistance
            </li>

            <li>
              <i class="fa-solid fa-check"></i>
              Book ambulance
            </li>

          </ul>

