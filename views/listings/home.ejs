<% layout("/layouts/boilerplate") %>

<!-- Hero -->
<div class="clinic-hero">
  <h1>Find the right doctor, book in minutes</h1>
  <p>Browse verified specialists, read real patient reviews, and get AI-powered help finding who you need.</p>
  <form action="/home" method="GET" class="clinic-hero-search">
    <input type="text" name="q" placeholder="Search by doctor name or location..." value="<%= query || '' %>" />
    <button type="submit">Search</button>
  </form>
</div>

<!-- Category cards -->
<div class="clinic-section-title">Browse by specialization</div>
<div class="clinic-section-subtitle">Find the right specialist for your needs</div>
<div class="category-scroll">
  <a href="/listings/specialization/General Physician" class="category-card">
    <img src="https://images.pexels.com/photos/7108250/pexels-photo-7108250.jpeg?auto=compress&cs=tinysrgb&w=400" alt="General Physician" />
    <div class="category-card-overlay"><span>General Physician</span></div>
  </a>
  <a href="/listings/specialization/Cardiologist" class="category-card">
    <img src="https://images.pexels.com/photos/6129500/pexels-photo-6129500.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Cardiologist" />
    <div class="category-card-overlay"><span>Cardiologist</span></div>
  </a>
  <a href="/listings/specialization/Neurologist" class="category-card">
    <img src="https://images.pexels.com/photos/5888143/pexels-photo-5888143.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Neurologist" />
    <div class="category-card-overlay"><span>Neurologist</span></div>
  </a>
  <a href="/listings/specialization/Dentist" class="category-card">
    <img src="https://images.pexels.com/photos/4021775/pexels-photo-4021775.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Dentist" />
    <div class="category-card-overlay"><span>Dentist</span></div>
  </a>
  <a href="/listings/specialization/Eye Specialist" class="category-card">
    <img src="https://images.pexels.com/photos/8459997/pexels-photo-8459997.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Eye Specialist" />
    <div class="category-card-overlay"><span>Eye Specialist</span></div>
  </a>
  <a href="/listings/specialization/Pediatrician" class="category-card">
    <img src="https://images.pexels.com/photos/8376309/pexels-photo-8376309.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Pediatrician" />
    <div class="category-card-overlay"><span>Pediatrician</span></div>
  </a>
  <a href="/listings/specialization/Vaccination" class="category-card">
    <img src="https://images.pexels.com/photos/19963130/pexels-photo-19963130.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Vaccination" />
    <div class="category-card-overlay"><span>Vaccination</span></div>
  </a>
  <a href="/listings/specialization/Diagnostics" class="category-card">
    <img src="https://images.pexels.com/photos/18828741/pexels-photo-18828741.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Diagnostics" />
    <div class="category-card-overlay"><span>Diagnostics</span></div>
  </a>
</div>

<!-- Trust badges -->
<div class="trust-grid">
  <div class="trust-card">
    <div class="icon">✅</div>
    <h6>Verified Listings</h6>
    <p>Every doctor profile is reviewed before it goes live.</p>
  </div>
  <div class="trust-card">
    <div class="icon">💬</div>
    <h6>AI Assistant</h6>
    <p>Ask our chatbot to help you find the right specialist.</p>
  </div>
  <div class="trust-card">
    <div class="icon">⭐</div>
    <h6>Real Patient Reviews</h6>
    <p>Honest ratings from patients who've booked before.</p>
  </div>
  <div class="trust-card">
    <div class="icon">🔒</div>
    <h6>Secure Booking</h6>
    <p>Your appointment slots are protected against double-booking.</p>
  </div>
</div>

<div class="clinic-section-title">All doctors</div>
<div class="clinic-section-subtitle">Browse and filter to find who's right for you</div>

<div class="clinic-filters">
  <a href="/listings/specialization/General Physician" class="clinic-filter-pill">
    <i class="fa-solid fa-user-doctor"></i> General Physicians
  </a>
  <a href="/listings/specialization/Cardiologist" class="clinic-filter-pill">
    <i class="fa-solid fa-heart-pulse"></i> Cardiologists
  </a>
  <a href="/listings/specialization/Neurologist" class="clinic-filter-pill">
    <i class="fa-solid fa-brain"></i> Neurologists
  </a>
  <a href="/listings/specialization/Dentist" class="clinic-filter-pill">
    <i class="fa-solid fa-tooth"></i> Dentists
  </a>
  <a href="/listings/specialization/Eye Specialist" class="clinic-filter-pill">
    <i class="fa-solid fa-eye"></i> Eye Specialists
  </a>
  <a href="/listings/specialization/Pediatrician" class="clinic-filter-pill">
    <i class="fa-solid fa-baby"></i> Pediatricians
  </a>
  <a href="/listings/specialization/Vaccination" class="clinic-filter-pill">
    <i class="fa-solid fa-syringe"></i> Vaccinations
  </a>
  <a href="/listings/specialization/Diagnostics" class="clinic-filter-pill">
    <i class="fa-solid fa-x-ray"></i> Diagnostics
  </a>
</div>

<% if (allListings.length === 0) { %>
  <div class="text-center mt-4">
    <% if (query) { %>
      <h4>No doctors found for "<%= query %>"</h4>
    <% } else { %>
      <h4>No doctors found in this specialization</h4>
    <% } %>
  </div>
<% } %>

<% if (allListings.length > 0) { %>
  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-3 mt-1 mb-4">
    <% for (let listing of allListings) { %>
      <div class="col">
        <a href="/listings/<%= listing._id %>" class="doctor-card">
          <img src="<%= listing.image.url %>" class="doctor-card-img" alt="doctor_image" />
          <div class="doctor-card-body">
            <div class="doctor-card-name">Dr. <%= listing.title %></div>
            <div class="doctor-card-spec"><%= listing.specialization %></div>
            <div class="doctor-card-fee">
              &#8377;<%= listing.price.toLocaleString("en-IN") %> consultation
            </div>
          </div>
        </a>
      </div>
    <% } %>
  </div>
<% } %>